{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Costura",
  "version": "0.1.0",
  "identifier": "com.costura.taller",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Costura — Gestión de taller",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
