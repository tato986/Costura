# ============================================================================
# TALLER COSTURA v2.0 — VARIABLES DE ENTORNO FIREBASE (PLANTILLA)
# Copia este archivo como `.env` cuando tengas los datos de Firebase Console.
# ============================================================================

# Credenciales del Proyecto Firebase (Web / Tauri Windows & macOS)
FIREBASE_API_KEY="REEMPLAZAR_CON_FIREBASE_API_KEY"
FIREBASE_AUTH_DOMAIN="REEMPLAZAR_PROJECT_ID.firebaseapp.com"
FIREBASE_PROJECT_ID="REEMPLAZAR_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="REEMPLAZAR_PROJECT_ID.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="REEMPLAZAR_MESSAGING_SENDER_ID"
FIREBASE_APP_ID="REEMPLAZAR_WEB_APP_ID"

# Opcional: Modo de operación ("cloud" | "emulator" | "offline_local")
COSTURA_FIREBASE_MODE="cloud"
COSTURA_FIREBASE_USE_EMULATORS="false"

# OAuth 2.0 para Google Sign-In (Android & Desktop)
COSTURA_GOOGLE_WEB_CLIENT_ID="REEMPLAZAR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"

# Puertos de Firebase Emulator Suite (Desarrollo Local)
COSTURA_EMULATOR_AUTH_URL="http://127.0.0.1:9099"
COSTURA_EMULATOR_FIRESTORE_HOST="127.0.0.1:8080"
COSTURA_EMULATOR_STORAGE_HOST="127.0.0.1:9199"
